# ==========================================================================
# INSIGHTAI ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to a '.env' file in your backend directory,
# and replace the placeholders with your actual keys/endpoints.
# ==========================================================================

# 1. AUTHENTICATION & SECURITY
SECRET_KEY=generate_your_random_secret_key
ALGORITHM=HS256
DB_PATH=database.db

# 2. BACKEND SERVICE AI CONFIGURATION
# Primary AI Provider (Loads google/gemma-4-26b-a4b-it by default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# Optional Secondary AI Provider (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. FRONTEND SERVICE CONFIGURATION
# Set the base URL of your FastAPI backend service.
# For local development, leave it commented out or set to http://localhost:8000.
VITE_API_BASE=http://localhost:8000
